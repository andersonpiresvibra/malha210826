function findForwardRouteBearingAndRemainingPath(
  userLat: number,
  userLng: number,
  path: Array<{ lat: number; lng: number }>,
  destLat: number,
  destLng: number
): {
  forwardBearingDeg: number;
  snappedLat: number;
  snappedLng: number;
  remainingPath: Array<{ lat: number; lng: number }>;
  closestIndex: number;
  isOffRoute: boolean;
